        <mxCell id="G81iZKOwdRqjZDgsLHHY-7" parent="G81iZKOwdRqjZDgsLHHY-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;fontColor=#FFFFFF;allowArrows=0;connectable=0;" value="Joint Research Centre" vertex="1">
