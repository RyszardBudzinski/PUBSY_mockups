        <UserObject label="&lt;div&gt;European Commission&amp;nbsp;&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Joint Research Centre&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;JRC Publications&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;gt;&amp;nbsp; Publications&lt;/span&gt;&lt;/div&gt;" id="Vhd51Vwr-3xDfxKTinUn-29">
          <mxCell parent="Vhd51Vwr-3xDfxKTinUn-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=14;fontColor=light-dark(#000000,#000000);fontStyle=0;connectable=0;allowArrows=0;" vertex="1">
            <mxGeometry height="30" width="940" x="199.85" y="220" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="Vhd51Vwr-3xDfxKTinUn-63" parent="Vhd51Vwr-3xDfxKTinUn-1" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.43333333333333335;arrowSize=0.625;fillColor=default;strokeColor=#B20000;shadow=0;rotation=-180;fontColor=#ffffff;strokeWidth=3;allowArrows=0;connectable=0;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="200" y="200" as="geometry" />
        </mxCell>
        <mxCell id="Bro3MNDFmTCDJhn1X9xL-0" parent="Vhd51Vwr-3xDfxKTinUn-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=16;fontColor=light-dark(#000000,#000000);fontStyle=0;allowArrows=0;connectable=0;" value="&lt;div style=&quot;line-height: 130%;&quot;&gt;&lt;b&gt;Abstract:&lt;/b&gt; &lt;span style=&quot;background-color: transparent;&quot;&gt;Accurate European scale building energy modelling remains challenging due to fragmented data, yet it is essential for assessing policy scenarios. This study proposes a data-driven methodology to identify a minimal set of essential variables for a reduced-form model capable of accurately predicting energy demand across European buildings. Using Random Forest machine learning applied to two complementary datasets: (1) a cross-country database of building typologies across the Member States of the European Union (EU), and (2) the French Energy Performance Certificate (EPC) database—the analysis identifies five key variables that reduce mean absolute percentage error by 10 percentage points compared to using all 18 original available attributes.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="917.15" x="202.85" y="430" as="geometry" />
        </mxCell>
        <mxCell id="Bro3MNDFmTCDJhn1X9xL-1" parent="Vhd51Vwr-3xDfxKTinUn-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=16;fontColor=light-dark(#3860ED,#3860ED);fontStyle=0;allowArrows=0;connectable=0;" value="&lt;div style=&quot;line-height: 130%;&quot;&gt;&lt;b&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;Authors:&lt;/font&gt;&lt;/b&gt;&amp;nbsp;FRANCO DE LOS RIOS Camilo&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;; MADUTA Carmen&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;; MARTINEZ Ana&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;; FLORIO Pietro&amp;nbsp; &amp;nbsp; &amp;nbsp; ; DAGOSTINO Delia&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;; TODESCHI Valeria&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;; KONA Albana&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="823" x="199.85000000000002" y="600" as="geometry" />
        </mxCell>
