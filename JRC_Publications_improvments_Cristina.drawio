        </mxCell>
        <mxCell id="G81iZKOwdRqjZDgsLHHY-8" parent="G81iZKOwdRqjZDgsLHHY-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;fontColor=#FFFFFF;allowArrows=0;connectable=0;" value="Help" vertex="1">
          <mxGeometry height="30" width="70" x="590" y="147.5" as="geometry" />
        </mxCell>
        <mxCell id="G81iZKOwdRqjZDgsLHHY-11" parent="G81iZKOwdRqjZDgsLHHY-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=16;fontColor=light-dark(#000000,#000000);fontStyle=0;allowArrows=0;connectable=0;" value="&lt;div style=&quot;line-height: 130%;&quot;&gt;&lt;b&gt;Abstract:&lt;/b&gt; &lt;span style=&quot;background-color: transparent;&quot;&gt;Accurate European scale building energy modelling remains challenging due to fragmented data, yet it is essential for assessing policy scenarios. This study proposes a data-driven methodology to identify a minimal set of essential variables for a reduced-form model capable of accurately predicting energy demand across European buildings. Using Random Forest machine learning applied to two complementary datasets: (1) a cross-country database of building typologies across the Member States of the European Union (EU), and (2) the French Energy Performance Certificate (EPC) database—the analysis identifies five key variables that reduce mean absolute percentage error by 10 percentage points compared to using all 18 original available attributes.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="820" x="250" y="380" as="geometry" />
        </mxCell>
        <mxCell id="G81iZKOwdRqjZDgsLHHY-12" parent="G81iZKOwdRqjZDgsLHHY-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=16;fontColor=light-dark(#3860ED,#3860ED);fontStyle=0;allowArrows=0;connectable=0;" value="&lt;div style=&quot;line-height: 130%;&quot;&gt;&lt;b&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;Authors:&lt;/font&gt;&lt;/b&gt;&amp;nbsp;FRANCO DE LOS RIOS Camilo&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;; MADUTA Carmen&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;; MARTINEZ Ana&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;; FLORIO Pietro&amp;nbsp; &amp;nbsp; &amp;nbsp; ; DAGOSTINO Delia&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;; TODESCHI Valeria&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;; KONA Albana&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="823" x="247" y="550" as="geometry" />
        </mxCell>
