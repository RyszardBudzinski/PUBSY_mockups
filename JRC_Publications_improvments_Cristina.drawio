        <mxCell id="Bro3MNDFmTCDJhn1X9xL-6" parent="Vhd51Vwr-3xDfxKTinUn-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=16;fontColor=light-dark(#000000,#000000);fontStyle=0;allowArrows=0;connectable=0;" value="&lt;div style=&quot;line-height: 130%;&quot;&gt;&lt;b&gt;Citation:&lt;/b&gt; FRANCO DE LOS RIOS, C., MADUTA, C., MARTINEZ, A., FLORIO, P., DAGOSTINO, D. et al., Identification of essential variables for the estimation of energy demand in buildings at European scale, JOURNAL OF BUILDING ENGINEERING, 119, 2026, p. 115222, ELSEVIER, https://data.europa.eu/doi/10.1016/j.jobe.2026.115222, JRC138964.&lt;/div&gt;" vertex="1">
